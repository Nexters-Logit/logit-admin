// ⚠️ 임시 마이그레이션 헬퍼 파일 — QA 라운드 마이그레이션 전용.
// qa_rounds 테이블 생성 + qa_test_results에 nullable 컬럼 추가(STEP A)만을 위해
// `prisma db push --schema=prisma/schema.step-a.prisma` 로 한 번 사용하고,
// scripts/migrate-qa-rounds.ts 백필이 끝나면 실제 schema.prisma(STEP C, 최종본)로
// `prisma db push`를 다시 실행한 뒤 이 파일은 삭제한다.
// 자세한 절차는 scripts/migrate-qa-rounds.ts 상단 주석 참고.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OAuthProvider {
  google
  apple
}

enum ChatRole {
  user
  assistant
}

model User {
  id                String        @id @default(uuid()) @db.Uuid
  email             String        @unique @db.VarChar(255)
  full_name         String?       @db.VarChar(255)
  is_active         Boolean       @default(true)
  oauth_provider    OAuthProvider?
  oauth_provider_id String?
  profile_image_url String?
  terms_agreed      Boolean       @default(false)
  terms_agreed_at   DateTime?     @db.Timestamptz
  refresh_token     String?
  created_at        DateTime      @db.Timestamptz
  updated_at        DateTime?     @db.Timestamptz

  projects  Project[]
  questions Question[]
  chats     Chat[]

  @@index([email], name: "users_email")
  @@index([oauth_provider], name: "users_oauth_provider")
  @@index([oauth_provider_id], name: "users_oauth_provider_id")
  @@map("users")
}

model Project {
  id              String    @id @default(uuid()) @db.Uuid
  user_id         String    @db.Uuid
  company         String    @db.VarChar(255)
  job_position    String    @db.VarChar(100)
  recruit_notice  String    @db.Text
  company_talent  String?   @db.Text
  due_date        DateTime? @db.Date
  created_at      DateTime  @db.Timestamptz
  updated_at      DateTime  @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz

  user      User       @relation(fields: [user_id], references: [id])
  questions Question[]
  chats     Chat[]

  @@index([user_id], name: "projects_user_id")
  @@map("projects")
}

model Question {
  id         String    @id @default(uuid()) @db.Uuid
  project_id String    @db.Uuid
  user_id    String    @db.Uuid
  question   String    @db.VarChar(100)
  max_length Int?
  order      Int       @default(1)
  answer     String?   @db.Text
  created_at DateTime  @db.Timestamptz
  updated_at DateTime  @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  project Project @relation(fields: [project_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])
  chats   Chat[]

  @@index([project_id], name: "questions_project_id")
  @@index([user_id], name: "questions_user_id")
  @@map("questions")
}

model Chat {
  id             String   @id @default(uuid()) @db.Uuid
  project_id     String   @db.Uuid
  question_id    String   @db.Uuid
  user_id        String   @db.Uuid
  role           ChatRole
  content        String   @db.Text
  experience_ids String[] @db.VarChar
  is_draft       Boolean  @default(false)
  is_selected    Boolean  @default(false)
  created_at     DateTime @db.Timestamptz

  project  Project  @relation(fields: [project_id], references: [id])
  question Question @relation(fields: [question_id], references: [id])
  user     User     @relation(fields: [user_id], references: [id])

  @@index([project_id], name: "chats_project_id")
  @@index([question_id], name: "chats_question_id")
  @@index([role], name: "chats_role")
  @@index([user_id], name: "chats_user_id")
  @@map("chats")
}

model Banner {
  id            Int      @id @default(autoincrement())
  image_url     String   @db.Text
  link_url      String?  @db.Text
  is_visible    Boolean  @default(true)
  display_order Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz

  @@map("banners")
}

model PaymentRecord {
  id                      String    @id @db.Uuid
  user_id                 String    @db.Uuid
  subscription_type       String
  plan                    String
  amount                  Int
  mul_no                  String?
  rebill_no               String?
  pay_state               Int?
  card_name               String?
  card_number             String?
  receipt_url             String?
  subscription_started_at DateTime? @db.Timestamptz
  subscription_expires_at DateTime? @db.Timestamptz
  paid_at                 DateTime? @db.Timestamptz
  created_at              DateTime  @db.Timestamptz

  @@map("payment_records")
}

model SubscriptionEvent {
  id               String   @id @db.Uuid
  user_id          String   @db.Uuid
  sub_type         String   @db.VarChar(20)
  event_type       String   @db.VarChar(40)
  plan             String?  @db.VarChar(20)
  rebill_no        String?
  amount           Int?
  payapp_response  String?
  notes            String?
  created_at       DateTime @db.Timestamptz

  @@map("subscription_events")
}

model AIUsageLog {
  id                String   @id @db.Uuid
  user_id           String   @db.VarChar(36)
  subscription_type String   @db.VarChar(20)
  plan              String   @db.VarChar(20)
  endpoint          String   @db.VarChar(50)
  model             String?  @db.VarChar(100)
  input_tokens      Int?
  output_tokens     Int?
  created_at        DateTime @db.Timestamptz

  @@index([user_id, created_at])
  @@index([subscription_type, created_at])
  @@index([plan, created_at])
  @@index([endpoint, created_at])
  @@index([created_at])
  @@map("ai_usage_logs")
}

model UserToken {
  user_id                    String    @id @db.Uuid
  balance                    Int       @default(0)
  last_monthly_grant_at      DateTime? @db.Timestamptz
  signup_bonus_granted       Boolean   @default(false)
  unnotified_referral_amount Int       @default(0)
  unnotified_referral_count  Int       @default(0)
  updated_at                 DateTime  @db.Timestamptz

  @@map("user_tokens")
}

model TokenTransaction {
  id          String   @id @db.Uuid
  user_id     String   @db.Uuid
  amount      Int
  type        String   @db.VarChar(30)
  description String?  @db.VarChar(200)
  created_at  DateTime @db.Timestamptz

  @@index([user_id, created_at])
  @@map("token_transactions")
}

model AttendanceLog {
  id         String   @id @db.Uuid
  user_id    String   @db.Uuid
  date       DateTime @db.Date
  created_at DateTime @db.Timestamptz

  @@unique([user_id, date])
  @@map("attendance_logs")
}

model AdminUser {
  email      String   @id @db.VarChar(255)
  name       String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  @@map("admin_users")
}

model QaTestCase {
  id          String   @id @default(uuid())
  category_l1 String   @db.VarChar(50)
  category_l2 String?  @db.VarChar(50)
  category_l3 String?  @db.VarChar(50)
  title       String   @db.VarChar(200)
  steps       String   @db.Text
  expected    String   @db.Text
  order       Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  results QaRoundItem?

  @@index([category_l1, category_l2, category_l3])
  @@map("qa_test_cases")
}

// QA 라운드(테스트 사이클). 하나의 라운드는 케이스 뱅크(QaTestCase)에서 고른
// 항목들을 스냅샷으로 담아 독립적인 결과 이력을 가진다.
model QaRound {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(200)
  description String?   @db.Text
  status      String    @default("in_progress") // "in_progress" | "closed"
  created_by  String?   @db.VarChar(255)
  closed_by   String?   @db.VarChar(255)
  closed_at   DateTime? @db.Timestamptz
  created_at  DateTime  @default(now()) @db.Timestamptz
  updated_at  DateTime  @updatedAt @db.Timestamptz

  items QaRoundItem[]

  @@map("qa_rounds")
}

// 라운드에 케이스가 "포함되어 있다"는 사실 자체를 이 row의 존재로 표현한다
// (별도 join 테이블 없음). category_l1~expected는 담는 시점의 스냅샷이라
// 케이스 뱅크 원본을 나중에 수정해도 과거 라운드 기록은 바뀌지 않는다.
// STEP A: round_id/스냅샷 필드는 잠시 nullable — 백필 후 STEP C에서 필수/복합키로 강화한다.
model QaRoundItem {
  case_id        String    @id // STEP C: round_id와 함께 복합 PK로 변경
  round_id       String? // STEP C: required
  category_l1    String?   @db.VarChar(50) // STEP C: required (스냅샷)
  category_l2    String?   @db.VarChar(50)
  category_l3    String?   @db.VarChar(50)
  title          String? // STEP C: required, @db.VarChar(200)
  steps          String?   @db.Text // STEP C: required
  expected       String?   @db.Text // STEP C: required
  tester_email   String?   @db.VarChar(255)
  status         String?
  device         String?   @db.Text
  situation      String?   @db.Text
  screenshot_url String?   @db.Text
  detail         String?   @db.Text
  confirmed      Boolean   @default(false)
  updated_by     String?   @db.VarChar(255)
  updated_at     DateTime  @updatedAt @db.Timestamptz

  case  QaTestCase @relation(fields: [case_id], references: [id], onDelete: Cascade) // STEP C: onDelete Restrict
  round QaRound?   @relation(fields: [round_id], references: [id], onDelete: Cascade)

  @@map("qa_test_results")
}

model Plan {
  id                String   @id @db.VarChar(50)
  subscription_type String   @db.VarChar(20)
  plan_key          String   @db.VarChar(20)
  name              String   @db.VarChar(100)
  original_price    Int
  price             Int
  monthly_tokens    Int      @default(0)
  description       String?  @db.Text
  badge             String?  @db.VarChar(100)
  features          Json?
  is_recommended    Boolean  @default(false)
  is_free           Boolean  @default(false)
  is_active         Boolean  @default(true)
  display_order     Int      @default(0)
  show_on_mobile    Boolean  @default(true)

  @@map("plans")
}
